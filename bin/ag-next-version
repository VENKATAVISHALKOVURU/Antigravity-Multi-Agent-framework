#!/usr/bin/env node
/**
 * ag-next-version: Compute the next version based on bump level.
 * Usage: ag-next-version [major|minor|patch|micro]
 * Reads from VERSION file. Writes to stdout.
 */

const fs = require('fs');

const bumpLevel = process.argv[2] || 'patch';
const versionFile = 'VERSION';

let current = '0.0.0.0';
if (fs.existsSync(versionFile)) {
  current = fs.readFileSync(versionFile, 'utf8').trim();
}

const parts = current.replace(/^v/, '').split('.').map(Number);
while (parts.length < 4) parts.push(0);
const [major, minor, patch, micro] = parts;

let next;
switch (bumpLevel) {
  case 'major': next = `${major + 1}.0.0.0`; break;
  case 'minor': next = `${major}.${minor + 1}.0.0`; break;
  case 'patch': next = `${major}.${minor}.${patch + 1}.0`; break;
  case 'micro': next = `${major}.${minor}.${patch}.${micro + 1}`; break;
  default:
    console.error(`Unknown bump level: ${bumpLevel}. Use major|minor|patch|micro`);
    process.exit(1);
}

process.stdout.write(next);
