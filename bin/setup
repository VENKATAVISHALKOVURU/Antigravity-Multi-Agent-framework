#!/usr/bin/env bash
# ag-stack setup script
set -e

echo ""
echo "╔══════════════════════════════════════════════════════════╗"
echo "║           ag-stack · Setup                              ║"
echo "╚══════════════════════════════════════════════════════════╝"
echo ""

# Check node
if ! command -v node &>/dev/null; then
  echo "❌ Node.js is required. Install from https://nodejs.org"
  exit 1
fi
NODE_VER=$(node -v | cut -d. -f1 | tr -d 'v')
if [ "$NODE_VER" -lt 18 ]; then
  echo "❌ Node.js 18+ required (found: $(node -v))"
  exit 1
fi
echo "✓ Node.js $(node -v)"

# Check git
if ! command -v git &>/dev/null; then
  echo "❌ git is required"
  exit 1
fi
echo "✓ git $(git --version | awk '{print $3}')"

# Install npm deps
echo ""
echo "Installing dependencies..."
npm install --silent
echo "✓ Dependencies installed"

# Make CLI executable
chmod +x ag.js
chmod +x bin/ag-stack-init
chmod +x bin/ag-next-version
chmod +x bin/ag-repro
echo "✓ CLI scripts made executable"

# Create global symlink
if [ -w /usr/local/bin ]; then
  ln -sf "$(pwd)/ag.js" /usr/local/bin/ag-stack
  echo "✓ ag-stack command available globally"
else
  echo "  ℹ To use ag-stack globally: sudo ln -sf $(pwd)/ag.js /usr/local/bin/ag-stack"
fi

# Create .ag directory
mkdir -p .ag/snapshots

echo ""
echo "✅ ag-stack ready."
echo ""
echo "Next steps:"
echo "  cd your-project"
echo "  ag-stack-init"
echo "  ag-stack autoplan \"Your goal here\""
echo ""
